# ==============================================================================
# CivicFix Platform - Shared Root Environment Configuration Template
# ==============================================================================

# Backend (Spring Boot)
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=civicfix_db
DB_USER=civicfix_user
DB_PASSWORD=civicfix_pass
DB_ROOT_PASSWORD=root_pass
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5
HIBERNATE_DDL_AUTO=update
SHOW_SQL=true

# Security & JWT Token Config (Minimum 32 characters for HMAC-SHA256)
JWT_SECRET=civicfixSuperSecretKeyForDevelopmentMustBe32CharactersOrLonger
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (React / Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME="CivicFix Platform"
VITE_DEFAULT_LANGUAGE=en

# AI Microservice (FastAPI)
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
AI_ENVIRONMENT=development
MODEL_NAME=municipal-grievance-classifier-v1
CONFIDENCE_THRESHOLD=0.75
