# ==============================================================================
# CivicFix Backend Environment Configuration
# ==============================================================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=civicfix_db
DB_USER=civicfix_user
DB_PASSWORD=civicfix_pass
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5
HIBERNATE_DDL_AUTO=update
SHOW_SQL=true

# Security & JWT (Secret must be at least 256-bit / 32 characters)
JWT_SECRET=civicfixSuperSecretKeyForDevelopmentMustBe32CharactersOrLonger
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Microservice URL
AI_SERVICE_URL=http://localhost:8000
